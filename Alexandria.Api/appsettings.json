{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KoboProxySettings" : {
    "AlexandriaApi": "http://alexandria.example.local",
    "StoreApi": "https://storeapi.kobo.com",
    "KoboRoutePrefix": "/api/kobo"
  },
  "AlexandriaSettings": {
    "DataFolder": "./App_Data",
    "EbookFolder": "/path/to/documents/Epubs",
    "AudiobookFolder": "/path/to/documents/Audiobooks"
  }
}
