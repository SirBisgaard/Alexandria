{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KoboProxySettings" : {
    "AlexandriaApi": "http://alexandria.example.local",
    "StoreApi": "https://storeapi.kobo.com"
  },
  "AlexandriaSettings": {
    "IndexFile": "/path/to/Alexandria/Content/Data/index.json",
