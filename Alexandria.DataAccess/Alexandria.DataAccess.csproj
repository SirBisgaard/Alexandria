<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alexandria.Business\Alexandria.Business.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
        <PackageReference Include="SharpCompress" Version="0.50.3" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    </ItemGroup>

    <!-- kepubify is a Go binary that has to match the host OS at runtime. The default copy is the
         Linux x86_64 build used by the production container; the OSX condition swaps in the Darwin
         x86_64 build for local Mac dev. Both land at the same output name so KepubifyWrapper.cs can
         stay platform-agnostic. -->
    <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
        <None Include="Externals/kepubify">
            <Pack>true</Pack>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <CopyToPublishSingleFile>Always</CopyToPublishSingleFile>
            <Link>kepubify</Link>
        </None>
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <None Include="Externals/kepubify-darwin">
            <Pack>true</Pack>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <CopyToPublishSingleFile>Always</CopyToPublishSingleFile>
            <Link>kepubify</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Files\Books\" />
    </ItemGroup>

    <Target Name="SetKepubifyPermissions" AfterTargets="Build" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
        <Exec Command="chmod +x $(OutputPath)/kepubify" />
    </Target>

</Project>
